<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mail_message_forward_wizard_view_form" model="ir.ui.view">
        <field name="name">mail.message.forward.wizard.form</field>
        <field name="model">mail.message.forward.wizard</field>
        <field name="arch" type="xml">
            <form string="Forward Message">
                <field name="message_id" invisible="1"/>
                <group>
                    <div class="o_forward_preview p-2 mb-2 bg-light border rounded">
                        <strong><field name="preview_author" nolabel="1" readonly="1"/></strong>
                        <span> — <field name="preview_date" nolabel="1" readonly="1"/></span>
                        <field name="preview_body" nolabel="1" readonly="1"/>
                    </div>
                </group>
                <group>
                    <field name="channel_ids" widget="many2many_tags" placeholder="Select channels..."/>
                    <field name="partner_ids" widget="many2many_tags" placeholder="Select people..."/>
                    <field name="note" placeholder="Add a comment (optional)"/>
                </group>
                <footer>
                    <button name="action_forward" type="object" string="Forward" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
